// Installed Prisma is 5.22.0. In this version, `url` and `directUrl`
// belong in schema.prisma (Prisma 7 moved them to prisma.config.ts).
// If the editor flags these fields, pin the Prisma extension to v6:
// Command Palette → "Prisma: Pin to Prisma 6" or prisma.pinToPrisma6.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  TEAM_MEMBER
}

enum PartyType {
  BUYER
  SUPPLIER
  KARIGAR
}

enum ProductCategory {
  RAW_MATERIAL
  FINISHED_GOOD
  ACCESSORY
  WASTAGE
}

enum UnitOfMeasure {
  KG
  PCS
  METERS
  ROLLS
}

enum SizeLabel {
  SIZE_0_3M
  SIZE_3_6M
  SIZE_6_9M
  SIZE_9_12M
  SIZE_12_18M
  SIZE_18_24M
}

enum ProductionStage {
  CUTTING
  PRINTING
  COLORING
  STITCHING
  FINISHING
}

enum BundleStage {
  CUTTING
  PRINTING
  COLORING
  STITCHING
  FINISHING
  BOXING
  COMPLETED
}

enum TaxType {
  ZERO_RATED
  IGST
  CGST_SGST
}

enum PaymentType {
  PIECE_RATE
  WEEKLY_SALARY
  BOTH
}

enum POStatus {
  ACTIVE
  IN_PRODUCTION
  READY_TO_SHIP
  COMPLETED
  CANCELLED
}

enum PurchaseBillStatus {
  PENDING
  CONFIRMED
  RETURNED
}

enum StockTransactionType {
  PURCHASE_IN
  ISSUE_OUT
  PRODUCTION_IN
  ADJUSTMENT
  WASTAGE_IN
  SALE_OUT
}

enum IssueType {
  CUTTING
  PRINTING
  STITCHING
  FINISHING
  SAMPLE
  PATTERN
}

enum IssueStatus {
  ISSUED
  RETURNED
  PARTIAL
}

enum WastageStatus {
  IN_STOCK
  SOLD
}

enum BundleStatus {
  IN_PROGRESS
  COMPLETED
}

enum ProductionEntryType {
  CUTTING
  PRINTING
  COLORING
  STITCHING
  FINISHING
}

enum PaymentStatus {
  PENDING
  PAID
}

enum BoxStatus {
  PACKED
  LOADED
}

enum ContainerStatus {
  LOADING
  READY
  DISPATCHED
}

enum SalesBillStatus {
  DRAFT
  SUBMITTED
  PAID
  RETURNED
}

enum NoteType {
  CREDIT
  DEBIT
}

enum VoucherType {
  PAYMENT
  RECEIPT
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  role              UserRole  @default(TEAM_MEMBER)
  inviteToken       String?
  inviteTokenExpiry DateTime?
  isActive          Boolean   @default(false)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  refreshTokens     RefreshToken[]
  stockTransactions StockTransaction[]
  issuesCreated     IssueRecord[]
  vouchersCreated   Voucher[]
  notifications     Notification[]
  filesUploaded     FileAttachment[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Party {
  id          String    @id @default(uuid())
  partyNumber String    @unique
  name        String
  type        PartyType
  contact     String?
  gstNumber   String?
  city        String?
  country     String?
  bankAccount String?
  ifsc        String?
  bankName    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  karigarProfile     KarigarProfile?
  buyerOrders        PurchaseOrder[]     @relation("POBuyer")
  supplierBills      PurchaseBill[]      @relation("BillSupplier")
  issuesAsKarigar    IssueRecord[]       @relation("IssueKarigar")
  wastageReturns     CuttingWastage[]    @relation("WastageReturnedBy")
  cuttingEntries     CuttingEntry[]      @relation("CuttingKarigar")
  printingEntries    PrintingEntry[]     @relation("PrintingKarigar")
  coloringEntries    ColoringEntry[]     @relation("ColoringKarigar")
  stitchingEntries   StitchingEntry[]    @relation("StitchingKarigar")
  finishingEntries   FinishingEntry[]    @relation("FinishingKarigar")
  karigarPayments    KarigarPayment[]    @relation("KarigarPaymentParty")
  buyerContainers    Container[]         @relation("ContainerBuyer")
  buyerSalesBills    SalesBill[]         @relation("SalesBuyer")
  creditDebitNotes   CreditDebitNote[]   @relation("NoteBuyer")
  supplierPayments   SupplierPayment[]   @relation("SupplierPaymentParty")
  ledgerEntries      LedgerEntry[]

  @@index([type])
  @@index([name])
  @@index([gstNumber])
  @@index([partyNumber])
}

model Product {
  id          String          @id @default(uuid())
  productCode String          @unique
  name        String
  category    ProductCategory
  unit        UnitOfMeasure
  gstRate     Decimal         @db.Decimal(5, 2)
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)

  sizes             ProductSize[]
  purchaseBills     PurchaseBill[]
  stock             Stock?
  stockTransactions StockTransaction[]
  issues            IssueRecord[]
  wastageAsFabric   CuttingWastage[]   @relation("WastageFabric")

  @@index([category])
  @@index([name])
}

model ProductSize {
  id        String    @id @default(uuid())
  productId String
  sizeLabel SizeLabel

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sizeLabel])
  @@index([productId])
}

model Operation {
  id            String           @id @default(uuid())
  operationCode String           @unique
  name          String
  stage         ProductionStage
  ratePerPiece  Decimal          @db.Decimal(12, 2)
  unit          UnitOfMeasure    @default(PCS)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)

  karigarOperations KarigarOperation[]
  stitchingEntries  StitchingEntry[]
  finishingEntries  FinishingEntry[]
  karigarPayments   KarigarPayment[]

  @@index([stage])
}

model GSTRate {
  id           String   @id @default(uuid())
  category     String
  gstPercent   Decimal  @db.Decimal(5, 2)
  taxType      TaxType
  applicableOn String
  notes        String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@index([category])
  @@index([applicableOn])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
}

model FileAttachment {
  id           String   @id @default(uuid())
  bucket       String
  objectPath   String
  originalName String
  mimeType     String
  sizeBytes    Int
  entityType   String
  entityId     String
  uploadedById String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([bucket, objectPath])
  @@index([entityType, entityId])
  @@index([uploadedById])
}

model KarigarProfile {
  id            String      @id @default(uuid())
  partyId       String      @unique
  paymentType   PaymentType
  weeklySalary  Decimal?    @db.Decimal(12, 2)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(6)

  party      Party              @relation(fields: [partyId], references: [id], onDelete: Restrict)
  operations KarigarOperation[]

  @@index([paymentType])
}

model KarigarOperation {
  id               String @id @default(uuid())
  karigarProfileId String
  operationId      String

  karigarProfile KarigarProfile @relation(fields: [karigarProfileId], references: [id], onDelete: Cascade)
  operation      Operation      @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@unique([karigarProfileId, operationId])
  @@index([operationId])
}

model PurchaseOrder {
  id                   String   @id @default(uuid())
  poNumber             String   @unique
  buyerId              String
  buyerPoReference     String?
  orderDate            DateTime @db.Timestamptz(6)
  deliveryDate         DateTime @db.Timestamptz(6)
  shippingDestination  String?
  paymentTerms         String?
  specialInstructions  String?
  status               POStatus @default(ACTIVE)
  totalPieces          Int      @default(0)
  totalDesigns         Int      @default(0)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  buyer             Party            @relation("POBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  items             POItem[]
  purchaseBills     PurchaseBill[]
  issues            IssueRecord[]
  wastage           CuttingWastage[]
  bundles           Bundle[]
  cuttingEntries    CuttingEntry[]
  printingEntries   PrintingEntry[]
  coloringEntries   ColoringEntry[]
  stitchingEntries  StitchingEntry[]
  finishingEntries  FinishingEntry[]
  karigarPayments   KarigarPayment[]
  boxes             BoxPacking[]
  containers        Container[]
  salesBills        SalesBill[]

  @@index([buyerId])
  @@index([status])
  @@index([orderDate])
}

model POItem {
  id           String @id @default(uuid())
  poId         String
  designNumber String
  garmentType  String
  color        String
  qty_0_3M     Int    @default(0)
  qty_3_6M     Int    @default(0)
  qty_6_9M     Int    @default(0)
  qty_9_12M    Int    @default(0)
  qty_12_18M   Int    @default(0)
  qty_18_24M   Int    @default(0)
  totalPieces  Int    @default(0)

  purchaseOrder    PurchaseOrder    @relation(fields: [poId], references: [id], onDelete: Cascade)
  issues           IssueRecord[]
  bundles          Bundle[]
  cuttingEntries   CuttingEntry[]
  boxes            BoxPacking[]
  salesBillItems   SalesBillItem[]

  @@index([poId])
  @@index([designNumber])
}

model PurchaseBill {
  id                 String              @id @default(uuid())
  billNumber         String              @unique
  supplierId         String
  supplierInvoiceNo  String?
  purchaseDate       DateTime            @db.Timestamptz(6)
  poId               String?
  productId          String
  vehicleNumber      String?
  grossWeight        Decimal             @db.Decimal(12, 3)
  tareWeight         Decimal             @db.Decimal(12, 3)
  netWeight          Decimal             @db.Decimal(12, 3)
  ratePerKg          Decimal             @db.Decimal(12, 2)
  gstPercent         Decimal             @db.Decimal(5, 2)
  gstAmount          Decimal             @db.Decimal(12, 2)
  totalAmount        Decimal             @db.Decimal(12, 2)
  status             PurchaseBillStatus  @default(PENDING)
  confirmedAt        DateTime?           @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)

  supplier Party         @relation("BillSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  po       PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  payments SupplierPayment[]

  @@index([supplierId])
  @@index([productId])
  @@index([status])
  @@index([purchaseDate])
}

model Stock {
  id          String   @id @default(uuid())
  productId   String   @unique
  quantity    Decimal  @db.Decimal(14, 3)
  lastUpdated DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
}

model StockTransaction {
  id              String                @id @default(uuid())
  productId       String
  transactionType StockTransactionType
  quantity        Decimal               @db.Decimal(14, 3)
  referenceType   String
  referenceId     String
  notes           String?
  createdById     String
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model IssueRecord {
  id             String      @id @default(uuid())
  issueNumber    String      @unique
  issueDate      DateTime    @db.Timestamptz(6)
  issueType      IssueType
  productId      String
  poId           String
  poItemId       String?
  karigarId      String
  quantityIssued Decimal     @db.Decimal(14, 3)
  bundleNumber   String?
  notes          String?
  createdById    String
  status         IssueStatus @default(ISSUED)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)

  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  poItem    POItem?       @relation(fields: [poItemId], references: [id], onDelete: SetNull)
  karigar   Party         @relation("IssueKarigar", fields: [karigarId], references: [id], onDelete: Restrict)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  bundles   Bundle[]

  @@index([productId])
  @@index([poId])
  @@index([karigarId])
  @@index([issueDate])
}

model CuttingWastage {
  id            String        @id @default(uuid())
  wastageNumber String        @unique
  poId          String
  designCode    String
  fabricTypeId  String
  wastageQty    Decimal       @db.Decimal(14, 3)
  returnedById  String
  dateOfReturn  DateTime      @db.Timestamptz(6)
  remarks       String?
  status        WastageStatus @default(IN_STOCK)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)

  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  fabricType Product       @relation("WastageFabric", fields: [fabricTypeId], references: [id], onDelete: Restrict)
  returnedBy Party         @relation("WastageReturnedBy", fields: [returnedById], references: [id], onDelete: Restrict)

  @@index([poId])
  @@index([status])
}

model Bundle {
  id           String         @id @default(uuid())
  bundleNumber String         @unique
  poId         String
  poItemId     String?
  issueId      String?
  currentStage BundleStage    @default(CUTTING)
  status       BundleStatus   @default(IN_PROGRESS)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)

  po        PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Restrict)
  poItem    POItem?        @relation(fields: [poItemId], references: [id], onDelete: SetNull)
  issue     IssueRecord?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  cutting   CuttingEntry[]
  printing  PrintingEntry[]
  coloring  ColoringEntry[]
  stitching StitchingEntry[]
  finishing FinishingEntry[]

  @@index([poId])
  @@index([currentStage])
  @@index([status])
}

model CuttingEntry {
  id             String   @id @default(uuid())
  entryNumber    String   @unique
  bundleId       String
  poId           String
  poItemId       String?
  karigarId      String
  entryDate      DateTime @db.Timestamptz(6)
  fabricIssuedKg Decimal  @db.Decimal(14, 3)
  totalPiecesCut Int
  qty_0_3M       Int      @default(0)
  qty_3_6M       Int      @default(0)
  qty_6_9M       Int      @default(0)
  qty_9_12M      Int      @default(0)
  qty_12_18M     Int      @default(0)
  qty_18_24M     Int      @default(0)
  wastageKg      Decimal  @default(0) @db.Decimal(14, 3)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  bundle  Bundle         @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  po      PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Restrict)
  poItem  POItem?        @relation(fields: [poItemId], references: [id], onDelete: SetNull)
  karigar Party          @relation("CuttingKarigar", fields: [karigarId], references: [id], onDelete: Restrict)

  @@index([bundleId])
  @@index([poId])
  @@index([karigarId])
}

model PrintingEntry {
  id              String   @id @default(uuid())
  entryNumber     String   @unique
  bundleId        String
  poId            String
  karigarId       String
  entryDate       DateTime @db.Timestamptz(6)
  piecesReceived  Int
  piecesReturned  Int
  piecesRejected  Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  bundle  Bundle        @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  karigar Party         @relation("PrintingKarigar", fields: [karigarId], references: [id], onDelete: Restrict)

  @@index([bundleId])
  @@index([poId])
}

model ColoringEntry {
  id              String   @id @default(uuid())
  entryNumber     String   @unique
  bundleId        String
  poId            String
  karigarId       String
  entryDate       DateTime @db.Timestamptz(6)
  colorApplied    String
  piecesReceived  Int
  piecesReturned  Int
  piecesRejected  Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  bundle  Bundle        @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  karigar Party         @relation("ColoringKarigar", fields: [karigarId], references: [id], onDelete: Restrict)

  @@index([bundleId])
  @@index([poId])
}

model StitchingEntry {
  id              String   @id @default(uuid())
  entryNumber     String   @unique
  bundleId        String
  poId            String
  karigarId       String
  operationId     String
  entryDate       DateTime @db.Timestamptz(6)
  piecesGiven     Int
  piecesReturned  Int
  piecesRejected  Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  bundle    Bundle        @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  karigar   Party         @relation("StitchingKarigar", fields: [karigarId], references: [id], onDelete: Restrict)
  operation Operation     @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([bundleId])
  @@index([operationId])
}

model FinishingEntry {
  id              String   @id @default(uuid())
  entryNumber     String   @unique
  bundleId        String
  poId            String
  karigarId       String
  operationId     String
  entryDate       DateTime @db.Timestamptz(6)
  piecesReceived  Int
  piecesCompleted Int
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  bundle    Bundle        @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  karigar   Party         @relation("FinishingKarigar", fields: [karigarId], references: [id], onDelete: Restrict)
  operation Operation     @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([bundleId])
  @@index([operationId])
}

model KarigarPayment {
  id                  String              @id @default(uuid())
  paymentNumber       String              @unique
  karigarId           String
  poId                String?
  operationId         String
  productionEntryType ProductionEntryType
  productionEntryId   String
  piecesCompleted     Int
  ratePerPiece        Decimal             @db.Decimal(12, 2)
  amountDue           Decimal             @db.Decimal(12, 2)
  weekNumber          Int
  year                Int
  status              PaymentStatus       @default(PENDING)
  paidAt              DateTime?           @db.Timestamptz(6)
  paymentMode         String?
  referenceNo         String?
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(6)

  karigar   Party          @relation("KarigarPaymentParty", fields: [karigarId], references: [id], onDelete: Restrict)
  po        PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  operation Operation      @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([karigarId])
  @@index([status])
  @@index([year, weekNumber])
}

model BoxPacking {
  id           String    @id @default(uuid())
  boxNumber    String    @unique
  poId         String
  poItemId     String?
  designNumber String
  color        String
  qty_0_3M     Int       @default(0)
  qty_3_6M     Int       @default(0)
  qty_6_9M     Int       @default(0)
  qty_9_12M    Int       @default(0)
  qty_12_18M   Int       @default(0)
  qty_18_24M   Int       @default(0)
  totalPieces  Int       @default(0)
  containerId  String?
  status       BoxStatus @default(PACKED)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  poItem    POItem?       @relation(fields: [poItemId], references: [id], onDelete: SetNull)
  container Container?    @relation(fields: [containerId], references: [id], onDelete: SetNull)

  @@index([poId])
  @@index([containerId])
  @@index([status])
}

model Container {
  id              String          @id @default(uuid())
  containerNumber String          @unique
  poId            String
  buyerId         String
  destination     String
  dispatchDate    DateTime?       @db.Timestamptz(6)
  status          ContainerStatus @default(LOADING)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  buyer      Party         @relation("ContainerBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  boxes      BoxPacking[]
  salesBills SalesBill[]

  @@index([poId])
  @@index([buyerId])
  @@index([status])
}

model SalesBill {
  id                  String          @id @default(uuid())
  invoiceNumber       String          @unique
  poId                String
  buyerId             String
  containerId         String?
  invoiceDate         DateTime        @db.Timestamptz(6)
  buyerPoReference    String?
  paymentTerms        String?
  shippingDestination String?
  currency            String          @default("USD")
  exchangeRate        Decimal         @db.Decimal(12, 6)
  subTotal            Decimal         @db.Decimal(12, 2)
  gstAmount           Decimal         @db.Decimal(12, 2)
  netTotal            Decimal         @db.Decimal(12, 2)
  status              SalesBillStatus @default(DRAFT)
  submittedAt         DateTime?       @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(6)

  po        PurchaseOrder     @relation(fields: [poId], references: [id], onDelete: Restrict)
  buyer     Party             @relation("SalesBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  container Container?        @relation(fields: [containerId], references: [id], onDelete: SetNull)
  items     SalesBillItem[]
  notes     CreditDebitNote[]

  @@index([poId])
  @@index([buyerId])
  @@index([status])
}

model SalesBillItem {
  id           String  @id @default(uuid())
  salesBillId  String
  poItemId     String?
  designNumber String
  garmentType  String
  color        String
  size         String
  quantity     Int
  ratePerPiece Decimal @db.Decimal(12, 2)
  amount       Decimal @db.Decimal(12, 2)

  salesBill SalesBill @relation(fields: [salesBillId], references: [id], onDelete: Cascade)
  poItem    POItem?   @relation(fields: [poItemId], references: [id], onDelete: SetNull)

  @@index([salesBillId])
}

model CreditDebitNote {
  id          String   @id @default(uuid())
  noteNumber  String   @unique
  type        NoteType
  salesBillId String
  buyerId     String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  date        DateTime @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  salesBill SalesBill @relation(fields: [salesBillId], references: [id], onDelete: Restrict)
  buyer     Party     @relation("NoteBuyer", fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([salesBillId])
  @@index([buyerId])
}

model SupplierPayment {
  id             String   @id @default(uuid())
  purchaseBillId String
  supplierId     String
  amountPaid     Decimal  @db.Decimal(12, 2)
  paymentDate    DateTime @db.Timestamptz(6)
  paymentMode    String
  referenceNo    String?
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  purchaseBill PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Restrict)
  supplier     Party        @relation("SupplierPaymentParty", fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([purchaseBillId])
  @@index([supplierId])
}

model Voucher {
  id               String      @id @default(uuid())
  voucherNumber    String      @unique
  type             VoucherType
  partyDescription String
  amount           Decimal     @db.Decimal(12, 2)
  paymentMode      String
  referenceNo      String?
  date             DateTime    @db.Timestamptz(6)
  notes            String?
  createdById      String
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(6)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([type])
  @@index([date])
}

model LedgerEntry {
  id            String   @id @default(uuid())
  partyId       String
  entryDate     DateTime @db.Timestamptz(6)
  description   String
  referenceType String
  referenceId   String
  debitAmount   Decimal  @default(0) @db.Decimal(12, 2)
  creditAmount  Decimal  @default(0) @db.Decimal(12, 2)
  balance       Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  party Party @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([partyId])
  @@index([entryDate])
  @@index([referenceType, referenceId])
}
