NODE_ENV=development
PORT=5000

# Prisma connects to this project's Supabase PostgreSQL (not a separate local Postgres).
# Copy both strings from Supabase → Connect → ORMs → Prisma.
# DATABASE_URL = Transaction pooler (port 6543) with ?pgbouncer=true
# DIRECT_URL   = Session mode (port 5432) for prisma migrate
DATABASE_URL="postgresql://postgres.xbpdumzzphpdiuuvadqp:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xbpdumzzphpdiuuvadqp:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"
APP_URL="http://localhost:3000"
# Production / Railway:
# CORS_ORIGIN="https://garment-erp-frontend-ivory.vercel.app,https://garment-erp-frontend-main-ebon.vercel.app,http://localhost:3000"
# FRONTEND_URL="https://garment-erp-frontend-ivory.vercel.app"
# BACKEND_URL="https://chic-presence-production-9ac1.up.railway.app"
# COOKIE_SAMESITE="none"
CORS_ORIGIN="http://localhost:3000"
COOKIE_SAMESITE="lax"
RATE_LIMIT_MAX="1000"
SWAGGER_ENABLED="true"

# Backend-only. Never put these in the frontend or as NEXT_PUBLIC_*.
SUPABASE_URL="https://xbpdumzzphpdiuuvadqp.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="erp-documents"

RESEND_API_KEY=
RESEND_FROM="FabricFlow ERP <noreply@example.com>"
INVITE_EXPIRY="48"

COMPANY_NAME="FabricFlow ERP"
COMPANY_ADDRESS=
COMPANY_CONTACT=
COMPANY_EMAIL=
COMPANY_GSTIN=
LOW_STOCK_THRESHOLD="100"

# Backend-only admin used by seed and `npm run admin:upsert`. Never add these to the frontend.
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Never set this on a live database. The demo seed is blocked against Supabase hosts.
# ALLOW_PRODUCTION_SEED=false
